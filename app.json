{
  "expo": {
    "name": "NonNon",
    "slug": "nonnon",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "nonnon",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#060D24",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.nonnon.english",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon-foreground.png",
        "backgroundColor": "#060D24"
      },
      "softwareKeyboardLayoutMode": "pan"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#060D24",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      "expo-status-bar",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "NonNon از میکروفون فقط هنگام تمرین تلفظ استفاده می‌کند.",
          "speechRecognitionPermission": "NonNon برای تشخیص تلفظ شما به تشخیص گفتار نیاز دارد."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
